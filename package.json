{
  "name": "playwright-with-copilot",
  "version": "0.1.0",
  "description": "Treinamento de testes E2E com Playwright, MCP, GitHub Copilot e GitHub Actions usando um Jogo da Memória",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.0.16"
  }
}
